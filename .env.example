# Copier ce fichier vers /etc/health-connect/app.env sur le serveur.
# Ne jamais y placer de vraies valeurs dans le dépôt.

DB_DSN="pgsql:host=/var/run/postgresql;dbname=health_connect"
DB_USER="healthconnect"
DB_PASSWORD_B64="BASE64_DU_MOT_DE_PASSE_POSTGRESQL"

MAX_BODY_BYTES="16777216"
MAX_RECORDS="1000"
MAX_DELETIONS="1000"
MAX_SAMPLES_PER_RECORD="20000"

# Laisser vide uniquement pour un test local temporaire sans mot de passe.
# Valeur attendue : base64_encode(password_hash(..., PASSWORD_DEFAULT)).
WEB_PASSWORD_HASH_B64=""

# Facultatif : connexion Google Health.
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""
GOOGLE_HEALTH_REDIRECT_URI="https://health.example.org/api/v1/google-health/callback"
GOOGLE_HEALTH_CRYPTO_KEY_B64=""
