server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;
    root /var/www/health-connect/public;
    index index.php;

    client_max_body_size 64m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # A full Health Connect baseline legitimately sends many authenticated
    # batches. Keep that traffic in its own bucket so it cannot starve the UI.
    location = /api/v1/sync/batches {
        client_max_body_size 16m;
        limit_req zone=health_connect_sync burst=100 nodelay;
        limit_req_status 429;
        try_files $uri /index.php?$query_string;
    }

    location /api/ {
        client_max_body_size 16m;
        limit_req zone=health_connect_web burst=60 nodelay;
        limit_req_status 429;
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    location ~ /\. {
        deny all;
    }
}
